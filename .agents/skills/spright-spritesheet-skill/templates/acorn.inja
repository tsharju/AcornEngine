{
  "frames": {
    {% set scale = first(textures).scale %}
    {% for sprite in sprites %}
    "{{ sprite.id }}": {
      "frame": {
        "x": {{ round(sprite.rect.x * scale, 0) }},
        "y": {{ round(sprite.rect.y * scale, 0) }},
        "w": {{ round(sprite.rect.w * scale, 0) }},
        "h": {{ round(sprite.rect.h * scale, 0) }}
      },
      "rotated": {{ sprite.rotated }},
      "trimmed": {% if sprite.sourceRect.w == sprite.trimmedSourceRect.w and sprite.sourceRect.h == sprite.trimmedSourceRect.h %}false{% else %}true{% endif %},
      "spriteSourceSize": {
        "x": {{ round(sprite.trimmedSourceRect.x * scale, 0) }},
        "y": {{ round(sprite.trimmedSourceRect.y * scale, 0) }},
        "w": {{ round(sprite.trimmedSourceRect.w * scale, 0) }},
        "h": {{ round(sprite.trimmedSourceRect.h * scale, 0) }}
      },
      "sourceSize": {
        "w": {{ round(sprite.sourceRect.w * scale, 0) }},
        "h": {{ round(sprite.sourceRect.h * scale, 0) }}
      }
    }{% if not loop.is_last %},{% endif %}
    {% endfor %}
  },
  "meta": {
    "app": "https://github.com/houmain/spright",
    "version": "1.0",
    "image": "{{ first(textures).filename }}",
    "format": "RGBA8888",
    "size": {
      "w": {{ first(textures).width }},
      "h": {{ first(textures).height }}
    },
    "scale": "{{ scale }}"
  }
}
